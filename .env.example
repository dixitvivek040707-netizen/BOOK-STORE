# Copy this file to .env for reference only. This project reads secrets from your terminal environment.
# Set ADMIN_PASSWORD in your terminal before starting the server.
# Use a unique password with at least 14 characters. Never commit real secrets.
ADMIN_PASSWORD=replace-with-a-unique-password-of-14-or-more-characters
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
